// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`prettier plugin > given code and escaped pipe fixture text, when normalizing directly, then output matches snapshots and stays stable 1`] = `
"| Pattern | Meaning |
| --- | --- |
| \`foo | bar\` | code pipe |
| \`foo  |  bar\` | padded code pipe |
| \`foo	|	bar\` | tabbed code pipe |
| foo\\|bar | escaped pipe |
"
`;

